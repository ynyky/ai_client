#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARENT_DIR="$(dirname "$SCRIPT_DIR")"

CONTAINER_NAME="ai-client"

if [[ -z "$AI_CLIENT_WORKSPACE" ]]; then
    AI_CLIENT_WORKSPACE="$(pwd)"
fi
# Build extra bind mounts from .volumes (one host path per line).
# Each path is mounted under the workspace using its basename.
VOLUME_ARGS=()
VOLUMES_FILE="$PARENT_DIR/.volumes"
if [[ -f "$VOLUMES_FILE" ]]; then
    while IFS= read -r host_path || [[ -n "$host_path" ]]; do
        # Skip blank lines and comments
        [[ -z "$host_path" || "$host_path" == \#* ]] && continue
        name="$(basename "$host_path")"
        VOLUME_ARGS+=(-v "$host_path:/home/claude/workspace/$name")
    done < "$VOLUMES_FILE"
fi


# Reset container if requested
if [[ "$1" == "--init" ]]; then
    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
fi

# Reuse existing container
if docker ps -a --format '{{.Names}}' | grep -Eq "^${CONTAINER_NAME}\$"; then
    docker start -ai "$CONTAINER_NAME"
    exit 0
fi

# Create new container
docker run \
  --name "$CONTAINER_NAME" \
  -e ANTHROPIC_API_KEY \
  --env-file "$PARENT_DIR/.ai_env" \
  -v "$AI_CLIENT_WORKSPACE:/home/claude/workspace" \
  -v "$PARENT_DIR/claude_config/.claude:/home/claude/.claude" \
  -v "$PARENT_DIR/claude_config/.claude.json:/home/claude/.claude.json" \
  -it ai-client:latest
