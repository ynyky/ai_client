{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "terraform": {
      "type": "stdio",
      "command": "terraform-mcp-server",
      "args": ["stdio"],
      "env": {}
    },
    "aws-iac": {
      "type": "stdio",
      "command": "awslabs.aws-iac-mcp-server",
      "args": [],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-documentation": {
      "type": "stdio",
      "command": "awslabs.aws-documentation-mcp-server",
      "args": [],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    }
  }
}
